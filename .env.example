PORT=4200
# Folder for sessions.json and leads.json. Empty = memory only.
DATA_DIR=./data

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# After this many hours of silence the chat history is cleared (lead details are kept)
SESSION_TTL_HOURS=24

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
HISTORY_LIMIT=16

# Package data published by the website (falls back to src/packages.fallback.json)
KNOWLEDGE_URL=https://mieyar-website.fly.dev/knowledge.json
KNOWLEDGE_CACHE_SECONDS=600
WEBSITE_URL=https://mieyar-website.fly.dev

# Lead notifications: owner's WhatsApp number (digits with country code, e.g. 96512345678)
OWNER_WHATSAPP_NUMBER=
# Approved template with one body parameter, e.g. "New Mieyar lead: {{1}}". Without it a normal
# text is sent, which WhatsApp only delivers if the owner messaged the bot in the last 24 hours.
OWNER_TEMPLATE_NAME=
OWNER_TEMPLATE_LANG=en

# Password for /admin/leads (user name: admin)
ADMIN_TOKEN=
